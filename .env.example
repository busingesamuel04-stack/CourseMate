# =============================================================
# CourseMate – Environment Variables Reference
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# -- Frontend (Vite) – exposed to the browser bundle ----------
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -- Backend (server.ts) – server-side only, never leaked -----
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key

# -- CORS – comma-separated list of allowed frontend origins --
# Development: http://localhost:5173
# Production:  https://coursemate-ug.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Scraper Settings ------------------------------------------
STUDENT_USER=IU/2023/BIT/001
STUDENT_PASS=YourSecretPasswordHere
HEADLESS=true
SCRAPER_TIMEOUT=45000
USE_MOCK=false

# -- Server Port -----------------------------------------------
PORT=3001
